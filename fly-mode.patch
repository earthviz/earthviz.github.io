+    - (pressedCameraKeys.has('Equal') || pressedCameraKeys.has('NumpadAdd') ? 1 : 0);
+  if (zoom) flightFov = clamp(flightFov * Math.exp(zoom * deltaSeconds * 1.2), FLIGHT_LIMITS.minFov, FLIGHT_LIMITS.maxFov);
